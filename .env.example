# Copy to .env (git-ignored) and fill in. Read by scripts/_common.ps1.
# Real environment variables with the same names win over this file.

# Password for the container's admin user. Required. Pick your own.
BC_CONTAINER_PASSWORD=

# Optional. Defaults shown.
# BC_CONTAINER=bcclass
# BC_CONTAINER_USER=admin
# BC_VERSION=28.0
# BC_COUNTRY=w1
